# =============================================================================
# software_dev: dev_net W8A8 kernel-development workload on LiteRT Micro
# (build from Linux / WSL)
#
#   make                  native host build
#   make run              host build + per-op check vs LiteRT reference
#   make CONFIG=rv64      bare-metal RV64IMC ELF (lp64 soft-float ABI)
#   make CONFIG=rv64 fp-audit
#                         F/D/A instruction count + soft-float call sites
#   make spike            build RV64 ELF + run under Spike (per-op cycles/instret)
#   make spike_mix        build RV64 ELF + dynamic instruction mix (Spike -g)
#
#   CUSTOM_KERNELS="CONV_2D"   (default) ops served by kernels/*.cc
#   CUSTOM_KERNELS=            all-TFLM-reference baseline
#
# The TFLM runtime and model objects are shared under build/$(CONFIG)/;
# main.cc, kernels/ and test_data/ are built per kernel selection under
# build/$(CONFIG)/<variant>/ (e.g. ref, custom_CONV_2D), so baseline and
# custom binaries coexist for A/B runs.
#
# tflm/, model/ and test_data/ are generated by scripts/gen_dev_workload.py.
# =============================================================================

CUSTOM_KERNELS ?= CONV_2D
CONFIG         ?= host
TFLM_DIR       ?= $(HOME)/tflite-micro
RISCV_PREFIX   ?= $(TFLM_DIR)/tensorflow/lite/micro/tools/make/downloads/riscv_toolchain/bin/riscv64-unknown-elf-
ARENA_SIZE     ?= 262144
EMULATE_FLOAT  ?= 1

SPIKE      ?= spike
PK         ?= pk
SPIKE_ISA  ?= rv64imac_zicsr_zifencei_zicntr
PYTHON3     ?= python3
RESULTS_DIR ?= ../../results

APP_NAME := dev_net
empty    :=
space    := $(empty) $(empty)
KERNELS  := $(strip $(CUSTOM_KERNELS))
VARIANT  := $(if $(KERNELS),custom_$(subst $(space),_,$(KERNELS)),ref)

BUILD      := build/$(CONFIG)
VBUILD     := $(BUILD)/$(VARIANT)
RV64_BIN   := build/rv64/$(VARIANT)/$(APP_NAME).elf
MIX_PREFIX := build/rv64/$(VARIANT)/$(APP_NAME)

RUNTIME_SRCS := $(wildcard model/*.cc) $(shell find tflm -name '*.cc' -o -name '*.c')
APP_SRCS     := main.cc $(wildcard kernels/*.cc) $(wildcard test_data/*.cc)

INCLUDES := -I. -Itflm -Itflm/third_party -Itflm/third_party/gemmlowp \
            -Itflm/third_party/flatbuffers/include -Itflm/third_party/kissfft \
            -Itflm/third_party/ruy -Itflm/third_party/eyalroz_printf/src

# Same defines as src/software/workload/Makefile (riscv32_generic target).
DEFINES := -DTF_LITE_STATIC_MEMORY -DTF_LITE_DISABLE_X86_NEON -DNDEBUG \
           -DTF_LITE_MCU_DEBUG_LOG -DTF_LITE_USE_GLOBAL_CMATH_FUNCTIONS \
           -DTF_LITE_USE_GLOBAL_MIN -DTF_LITE_USE_GLOBAL_MAX \
           -DPRINTF_SUPPORT_DECIMAL_SPECIFIERS=0 \
           -DPRINTF_SUPPORT_EXPONENTIAL_SPECIFIERS=0 \
           -DWORKLOAD_ARENA_SIZE=$(ARENA_SIZE)
ifeq ($(EMULATE_FLOAT),1)
  DEFINES += -DTFLITE_EMULATE_FLOAT
endif
APP_DEFINES := -DGARIBALDI_CUSTOM_KERNELS='"$(KERNELS)"' \
               $(foreach k,$(KERNELS),-DGARIBALDI_CUSTOM_$(k))

COMMON   := -O2 -ffunction-sections -fdata-sections -fno-unwind-tables \
            -fno-asynchronous-unwind-tables -MMD -MP $(DEFINES) $(INCLUDES)
CXXFLAGS := -std=c++17 -fno-rtti -fno-exceptions -fno-threadsafe-statics $(COMMON)
CFLAGS   := -std=c17 $(COMMON)

ifeq ($(CONFIG),rv64)
  CXX        := $(RISCV_PREFIX)g++
  CC         := $(RISCV_PREFIX)gcc
  OBJDUMP    := $(RISCV_PREFIX)objdump
  ARCH_FLAGS := -march=rv64imc -mabi=lp64 -mcmodel=medany -mexplicit-relocs \
                -fno-builtin-printf
  CXXFLAGS   += -fpermissive -fno-use-cxa-atexit
  LDFLAGS    := -march=rv64imac -mabi=lp64 -mcmodel=medany --specs=nano.specs \
                -mno-relax -Wl,--gc-sections
  EXE        := .elf
else
  CXX        := g++
  CC         := gcc
  OBJDUMP    := objdump
  ARCH_FLAGS :=
  LDFLAGS    := -Wl,--gc-sections
  EXE        :=
endif

RUNTIME_OBJS := $(patsubst %,$(BUILD)/%.o,$(RUNTIME_SRCS))
APP_OBJS     := $(patsubst %,$(VBUILD)/%.o,$(APP_SRCS))
BIN          := $(VBUILD)/$(APP_NAME)$(EXE)

SOFTFLOAT_RE := __((add|sub|mul|div|neg)[sd]f3|float(un)?[sdt]i[sd]f|fix(uns)?[sd]f[sdt]i|extendsfdf2|truncdfsf2|(eq|ne|lt|le|gt|ge|unord)[sd]f2)

.PHONY: all run fp-audit spike spike_mix clean

all: $(BIN)

$(VBUILD)/%.cc.o: %.cc
	@mkdir -p $(@D)
	$(CXX) $(ARCH_FLAGS) $(CXXFLAGS) $(APP_DEFINES) -c $< -o $@

$(BUILD)/%.cc.o: %.cc
	@mkdir -p $(@D)
	$(CXX) $(ARCH_FLAGS) $(CXXFLAGS) -c $< -o $@

$(BUILD)/%.c.o: %.c
	@mkdir -p $(@D)
	$(CC) $(ARCH_FLAGS) $(CFLAGS) -c $< -o $@

$(BIN): $(APP_OBJS) $(RUNTIME_OBJS)
	$(CXX) $(ARCH_FLAGS) $^ $(LDFLAGS) -lm -o $@

-include $(APP_OBJS:.o=.d) $(RUNTIME_OBJS:.o=.d)

run: $(BIN)
ifeq ($(CONFIG),host)
	./$(BIN)
else
	@echo "CONFIG=$(CONFIG) needs a bare-metal platform (e.g. Spike); 'make run' is host-only." && exit 1
endif

fp-audit: $(BIN)
	@$(OBJDUMP) -d $(BIN) > $(VBUILD)/disasm.txt
	@printf "F/D-extension instructions: "; \
	  grep -cP '^\s+[0-9a-f]+:\s+[0-9a-f]+\s+f(?!ence)[a-z]+(\.[a-z.]+)?\s' $(VBUILD)/disasm.txt || true
	@printf "A-extension instructions:   "; \
	  grep -cP '^\s+[0-9a-f]+:\s+[0-9a-f]+\s+(amo[a-z]+|lr|sc)\.[wd]' $(VBUILD)/disasm.txt || true
	@echo "Functions calling soft-float helpers:"
	@awk '/^[0-9a-f]+ <.*>:$$/ { fn = substr($$2, 2, length($$2) - 3) } \
	      /<$(SOFTFLOAT_RE)>/ && fn !~ /^$(SOFTFLOAT_RE)$$/ { print fn }' $(VBUILD)/disasm.txt \
	  | sort -u | $(RISCV_PREFIX)c++filt | sed 's/^/  /'

# spike / spike_mix: see src/software/workload/Makefile. The instruction mix
# goes to $(RESULTS_DIR)/insn_mix/dev_net_<variant>.*
spike: $(RV64_BIN)
	$(SPIKE) --isa=$(SPIKE_ISA) $(PK) $(RV64_BIN)

spike_mix: $(RV64_BIN)
	@echo "[spike_mix] Running under Spike with the PC histogram enabled (-g)..."
	-$(SPIKE) -g --isa=$(SPIKE_ISA) $(PK) $(RV64_BIN) \
	    > $(MIX_PREFIX).stdout.txt 2> $(MIX_PREFIX).pc_hist.txt
	@cat $(MIX_PREFIX).stdout.txt
	$(RISCV_PREFIX)objdump -d -C -M no-aliases $(RV64_BIN) > $(MIX_PREFIX).disasm.txt
	$(PYTHON3) ../../scripts/insn_mix.py --hist $(MIX_PREFIX).pc_hist.txt \
	    --disasm $(MIX_PREFIX).disasm.txt --spike-out $(MIX_PREFIX).stdout.txt \
	    --out $(RESULTS_DIR)/insn_mix/$(APP_NAME)_$(VARIANT)

# When CONFIG is already rv64, $(BIN) == $(RV64_BIN) and the link rule above
# builds it; a second recipe here would recurse forever.
ifneq ($(CONFIG),rv64)
$(RV64_BIN):
	$(MAKE) CONFIG=rv64 CUSTOM_KERNELS="$(KERNELS)"
endif

clean:
	rm -rf build
