# =============================================================================
# ResNet-18 golden-vector test (build from Linux / WSL)
#
#   make                  native host build
#   make run              host build + bit-exact check vs LiteRT reference
#   make CONFIG=rv64      bare-metal RV64IMC ELF
#   make spike            build RV64 ELF + run under Spike (cycles/instret)
#   make spike_mix        build RV64 ELF + dynamic instruction mix (Spike -g)
#
# Builds through ../workload/Makefile with APP=test, so it links the same TFLM
# runtime objects and uses the same flags as the photo demo.
# test_data/ is generated by scripts/ml_workload/gen_test_data.py.
# =============================================================================

WORKLOAD_DIR := ../workload

.PHONY: all run spike spike_mix fp-audit clean

all run spike spike_mix fp-audit:
	$(MAKE) -C $(WORKLOAD_DIR) APP=test $@

# Removes only the test objects/binaries; the shared runtime objects stay.
clean:
	rm -rf $(WORKLOAD_DIR)/build/*/test $(WORKLOAD_DIR)/build/*/resnet18_test*
