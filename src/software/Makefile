# =============================================================================
# ResNet-18 W8A8 LiteRT Micro: shared runtime + build for the application
# programs (build from Linux / WSL)
#
#   make                  native host build (functional reference)
#   make run              host build + run the selected APP
#   make CONFIG=rv64      bare-metal RV64IMC ELF (lp64 soft-float ABI)
#   make CONFIG=rv64 fp-audit
#                         F/D/A instruction count + soft-float call sites
#   make spike            build RV64 ELF + dynamic instruction mix (Spike -g)
#
#   APP=test (default)    golden-vector check: test/main.cc + test/test_data/
#   APP=demo              ImageNet photo demo: demo/main.cc + demo/demo_data/
#                         (N=count limits photos)
#   Both apps link the same runtime objects (build/<config>/{tflm,model}/)
#   with the same flags; app objects go under build/<config>/<app>/.
#
# workload/ (tflm/ + model/) is generated by scripts/ml_workload/gen_tflm_workload.py.
# test/test_data/ is generated by scripts/ml_workload/gen_test_data.py.
# demo/demo_data/ is generated by scripts/ml_workload/gen_demo_data.py.
# =============================================================================

APP          ?= test
N            ?=
RUN_ARGS     ?= $(N)
CONFIG       ?= host
TFLM_DIR     ?= $(HOME)/tflite-micro
RISCV_PREFIX ?= $(TFLM_DIR)/tensorflow/lite/micro/tools/make/downloads/riscv_toolchain/bin/riscv64-unknown-elf-
ARENA_SIZE   ?= 3145728
EMULATE_FLOAT ?= 1

# ---------------------------------------------------------------------------
# Spike ISA simulator settings
# ---------------------------------------------------------------------------
SPIKE      ?= spike
PK         ?= pk
SPIKE_ISA  ?= rv64imac_zicsr_zifencei_zicntr
PYTHON3     ?= python3
RESULTS_DIR ?= ../../results

WORKLOAD_DIR := workload
TFLM         := $(WORKLOAD_DIR)/tflm
BUILD_ROOT   ?= build

ifeq ($(APP),demo)
  APP_NAME := resnet18_demo
  APP_SRCS := demo/main.cc $(wildcard demo/demo_data/*.cc)
else ifeq ($(APP),test)
  APP_NAME := resnet18_test
  APP_SRCS := test/main.cc $(wildcard test/test_data/*.cc)
else
  $(error APP must be 'test' or 'demo', got '$(APP)')
endif

RV64_BIN   := $(BUILD_ROOT)/rv64/$(APP_NAME).elf
MIX_PREFIX := $(BUILD_ROOT)/rv64/$(APP_NAME)

RUNTIME_SRCS := $(wildcard $(WORKLOAD_DIR)/model/*.cc) \
                $(shell find $(TFLM) -name '*.cc' -o -name '*.c')

# -I$(APP): generated data sources include "test_data/..." / "demo_data/..."
# relative to the app directory; model sources include "model/...".
INCLUDES := -I$(WORKLOAD_DIR) -I$(APP) -I$(TFLM) -I$(TFLM)/third_party \
            -I$(TFLM)/third_party/gemmlowp -I$(TFLM)/third_party/flatbuffers/include \
            -I$(TFLM)/third_party/kissfft -I$(TFLM)/third_party/ruy \
            -I$(TFLM)/third_party/eyalroz_printf/src

# TF_LITE_* match TFLM's riscv32_generic target. TFLITE_EMULATE_FLOAT makes
# QuantizeMultiplier() use its integer frexp. The PRINTF_* switches drop the
# %f/%e paths from the bundled printf.
DEFINES := -DTF_LITE_STATIC_MEMORY -DTF_LITE_DISABLE_X86_NEON -DNDEBUG \
           -DTF_LITE_MCU_DEBUG_LOG -DTF_LITE_USE_GLOBAL_CMATH_FUNCTIONS \
           -DTF_LITE_USE_GLOBAL_MIN -DTF_LITE_USE_GLOBAL_MAX \
           -DPRINTF_SUPPORT_DECIMAL_SPECIFIERS=0 \
           -DPRINTF_SUPPORT_EXPONENTIAL_SPECIFIERS=0 \
           -DWORKLOAD_ARENA_SIZE=$(ARENA_SIZE)
ifeq ($(EMULATE_FLOAT),1)
  DEFINES += -DTFLITE_EMULATE_FLOAT
endif

COMMON   := -O2 -ffunction-sections -fdata-sections -fno-unwind-tables \
            -fno-asynchronous-unwind-tables $(DEFINES) $(INCLUDES)
CXXFLAGS := -std=c++17 -fno-rtti -fno-exceptions -fno-threadsafe-statics $(COMMON)
CFLAGS   := -std=c17 $(COMMON)

ifeq ($(CONFIG),rv64)
  CXX        := $(RISCV_PREFIX)g++
  CC         := $(RISCV_PREFIX)gcc
  OBJDUMP    := $(RISCV_PREFIX)objdump
  ARCH_FLAGS := -march=rv64imc -mabi=lp64 -mcmodel=medany -mexplicit-relocs \
                -fno-builtin-printf
  CXXFLAGS   += -fpermissive -fno-use-cxa-atexit
  # The toolchain has no rv64imc multilib; rv64imac/lp64 is the nearest
  # soft-float newlib. fp-audit checks the linked ELF for A/F/D instructions.
  LDFLAGS    := -march=rv64imac -mabi=lp64 -mcmodel=medany --specs=nano.specs \
                -mno-relax -Wl,--gc-sections
  EXE        := .elf
else
  CXX        := g++
  CC         := gcc
  OBJDUMP    := objdump
  ARCH_FLAGS :=
  LDFLAGS    := -Wl,--gc-sections
  EXE        :=
endif

BUILD := $(BUILD_ROOT)/$(CONFIG)
OBJS  := $(patsubst %,$(BUILD)/%.o,$(APP_SRCS) $(RUNTIME_SRCS:$(WORKLOAD_DIR)/%=%))
BIN   := $(BUILD)/$(APP_NAME)$(EXE)

SOFTFLOAT_RE := __((add|sub|mul|div|neg)[sd]f3|float(un)?[sdt]i[sd]f|fix(uns)?[sd]f[sdt]i|extendsfdf2|truncdfsf2|(eq|ne|lt|le|gt|ge|unord)[sd]f2)

.PHONY: all run fp-audit spike clean

all: $(BIN)

$(BUILD)/%.cc.o: $(WORKLOAD_DIR)/%.cc
	@mkdir -p $(@D)
	$(CXX) $(ARCH_FLAGS) $(CXXFLAGS) -c $< -o $@

$(BUILD)/%.c.o: $(WORKLOAD_DIR)/%.c
	@mkdir -p $(@D)
	$(CC) $(ARCH_FLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/$(APP)/%.cc.o: $(APP)/%.cc
	@mkdir -p $(@D)
	$(CXX) $(ARCH_FLAGS) $(CXXFLAGS) -c $< -o $@

$(BIN): $(OBJS)
	$(CXX) $(ARCH_FLAGS) $(OBJS) $(LDFLAGS) -lm -o $@

run: $(BIN)
ifeq ($(CONFIG),host)
	./$(BIN) $(RUN_ARGS)
else
	@echo "CONFIG=$(CONFIG) needs a bare-metal platform (e.g. Spike); 'make run' is host-only." && exit 1
endif

fp-audit: $(BIN)
	@$(OBJDUMP) -d $(BIN) > $(BUILD)/disasm.txt
	@printf "F/D-extension instructions: "; \
	  grep -cP '^\s+[0-9a-f]+:\s+[0-9a-f]+\s+f(?!ence)[a-z]+(\.[a-z.]+)?\s' $(BUILD)/disasm.txt || true
	@printf "A-extension instructions:   "; \
	  grep -cP '^\s+[0-9a-f]+:\s+[0-9a-f]+\s+(amo[a-z]+|lr|sc)\.[wd]' $(BUILD)/disasm.txt || true
	@echo "Functions calling soft-float helpers:"
	@awk '/^[0-9a-f]+ <.*>:$$/ { fn = substr($$2, 2, length($$2) - 3) } \
	      /<$(SOFTFLOAT_RE)>/ && fn !~ /^$(SOFTFLOAT_RE)$$/ { print fn }' $(BUILD)/disasm.txt \
	  | sort -u | $(RISCV_PREFIX)c++filt | sed 's/^/  /'

# ---------------------------------------------------------------------------
# Spike ISA simulator targets
#   Prerequisites: spike and pk must be on PATH (see: make get_spike at the
#   top level, or run scripts/tool_installation/install_spike.sh in WSL).
#
#   spike  — build RV64 ELF then run one inference with Spike's per-PC retire
#            counter (-g); prints the cycle + instret counts from the CSR reads
#            embedded in the app's main.cc, and joins the histogram with the
#            ELF disassembly into a dynamic instruction mix (per mnemonic /
#            class / function / hot basic block) under
#            $(RESULTS_DIR)/spike_results/. Do not use --log-commits for the
#            full model: ~20 G instructions is ~1.3 TB of commit log.
# ---------------------------------------------------------------------------
spike: $(RV64_BIN)
	@mkdir -p $(BUILD_ROOT)/rv64
	@echo "[spike] Running under Spike with the PC histogram enabled (-g)..."
	-$(SPIKE) -g --isa=$(SPIKE_ISA) $(PK) $(RV64_BIN) $(RUN_ARGS) \
	    > $(MIX_PREFIX).stdout.txt 2> $(MIX_PREFIX).pc_hist.txt
	@cat $(MIX_PREFIX).stdout.txt
	$(RISCV_PREFIX)objdump -d -C -M no-aliases $(RV64_BIN) > $(MIX_PREFIX).disasm.txt
	$(PYTHON3) ../../scripts/result_extraction/inspect_spike.py \
	    --hist $(MIX_PREFIX).pc_hist.txt \
	    --disasm $(MIX_PREFIX).disasm.txt --spike-out $(MIX_PREFIX).stdout.txt \
	    --out $(RESULTS_DIR)/spike_results/$(APP_NAME)

# Explicit rule so 'make spike' can force CONFIG=rv64.
# Guard: when CONFIG is already rv64, $(BIN)==$(RV64_BIN) and the compile rule
# above ($(BIN): $(OBJS)) is sufficient — adding a second recipe here causes
# an infinite recursive $(MAKE) CONFIG=rv64 loop.
ifneq ($(CONFIG),rv64)
$(RV64_BIN):
	$(MAKE) CONFIG=rv64 APP=$(APP)
endif

clean:
	rm -rf $(BUILD_ROOT)
