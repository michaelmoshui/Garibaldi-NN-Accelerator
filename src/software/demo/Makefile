# =============================================================================
# ResNet-18 ImageNet photo demo (build from Linux / WSL)
#
#   make                  native host build
#   make run              host build + classify all photos
#   make run N=3          classify only the first 3 photos
#   make CONFIG=rv64      bare-metal RV64IMC ELF
#   make spike [N=3]      build RV64 ELF + classify under Spike (cycles/instret
#                         per photo; ~20 G instructions / ~70 s per photo)
#   make spike_mix [N=1]  dynamic instruction mix over the classified photos
#
# Builds through ../workload/Makefile with APP=demo, so it links the same TFLM
# runtime objects and uses the same flags as the golden-vector test.
# demo_data/ and images/ are generated by scripts/ml_workload/gen_demo_data.py.
# =============================================================================

WORKLOAD_DIR := ../workload
N            ?=

.PHONY: all run spike spike_mix fp-audit clean

all run spike spike_mix fp-audit:
	$(MAKE) -C $(WORKLOAD_DIR) APP=demo RUN_ARGS=$(N) $@

# Removes only the demo objects/binaries; the shared runtime objects stay.
clean:
	rm -rf $(WORKLOAD_DIR)/build/*/demo $(WORKLOAD_DIR)/build/*/resnet18_demo*
